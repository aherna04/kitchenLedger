# Host folder mounted into the container at /media.
# This is the main Docker setting — create inbox/ under it for scans.
KL_HOST_PATH=/Users/alex/KitchenLedger

# The following are for local (non-Docker) runs only.
# docker-compose.yml hardcodes KL_ROOT=/media and KL_DATA_DIR=/media/.kitchenLedger
# inside the container so a host-shell KL_ROOT cannot leak in.
KL_ROOT=/media
KL_DATA_DIR=/media/.kitchenLedger
